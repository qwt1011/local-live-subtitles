{
  "manifest_version": 3,
  "name": "Local Live Subtitles",
  "version": "0.1.0",
  "description": "Local Japanese and English subtitles for YouTube.",
  "permissions": ["activeTab", "storage", "tabCapture", "offscreen"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {"default_popup": "popup.html"},
  "background": {"service_worker": "background.js"},
  "web_accessible_resources": [{"resources": ["offscreen.html", "offscreen.js"], "matches": ["https://www.youtube.com/*"]}],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
